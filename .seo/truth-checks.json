[
  {
    "claim": "Hosted access starts with a seven-day trial, not an ongoing free plan",
    "paths": [
      "frontend/templates/pages/pricing.html"
    ],
    "urls": [
      "/pricing"
    ],
    "flags": "i",
    "must_match": [
      "7-day trial"
    ],
    "must_not_match": [
      "free forever",
      "free tier",
      "14-day trial",
      "30-day trial"
    ]
  },
  {
    "claim": "Public previews are read-only; private programmatic access is authenticated",
    "paths": [
      "apps/pages/content/docs/mcp-rest-public-previews.md",
      "apps/pages/content/docs/dataset-api.md"
    ],
    "urls": [
      "/docs/mcp-rest-public-previews",
      "/docs/dataset-api"
    ],
    "flags": "i",
    "must_match": [
      "read.only",
      "Bearer"
    ],
    "must_not_match": []
  },
  {
    "claim": "Rowset exports CSV, JSONL, XLSX, SQLite and Parquet",
    "paths": [
      "frontend/templates/pages/landing-page.html",
      "apps/pages/content/docs/dataset-api.md"
    ],
    "urls": [
      "/",
      "/docs/dataset-api"
    ],
    "flags": "i",
    "must_match": [
      "CSV",
      "JSONL",
      "XLSX",
      "SQLite",
      "Parquet"
    ],
    "must_not_match": []
  },
  {
    "claim": "Rowset comparisons acknowledge supported self-hosting",
    "paths": [
      "apps/pages/content/blog/baserow-alternatives.md",
      "apps/pages/content/blog/google-sheets-alternatives.md"
    ],
    "urls": [
      "/blog/baserow-alternatives",
      "/blog/google-sheets-alternatives"
    ],
    "flags": "is",
    "must_match": [
      "Rowset is (?:also )?open source",
      "self-hosting guide"
    ],
    "must_not_match": [
      "No\\. Rowset is a hosted private backend",
      "plugins, or self-hosting",
      "Baserow if open-source deployment or self-hosting is required"
    ]
  },
  {
    "claim": "Baserow supports built-in MCP; comparison is workflow scope",
    "paths": [
      "apps/pages/content/blog/baserow-alternatives.md",
      "apps/pages/content/blog/google-sheets-alternatives.md"
    ],
    "urls": [
      "/blog/baserow-alternatives",
      "/blog/google-sheets-alternatives"
    ],
    "flags": "i",
    "must_match": [
      "built-in MCP"
    ],
    "must_not_match": [
      "You want hosted MCP and REST for delegated agent workflows"
    ]
  },
  {
    "claim": "Google Sheets comparison acknowledges official MCP preview and separates standard capacity from beta",
    "paths": [
      "apps/pages/content/vs/google-sheets.md"
    ],
    "urls": [
      "/vs/google-sheets"
    ],
    "flags": "is",
    "must_match": [
      "official Sheets MCP",
      "Developer Preview",
      "10 million cells",
      "18,278",
      "20 million cells",
      "beta"
    ],
    "must_not_match": [
      "Google Sheets does not support MCP",
      "20 million cells for every"
    ]
  },
  {
    "claim": "Google Sheets comparison cites current API quotas and Gemini eligibility, not a past promotional allowance",
    "paths": [
      "apps/pages/content/vs/google-sheets.md"
    ],
    "urls": [
      "/vs/google-sheets"
    ],
    "flags": "is",
    "must_match": [
      "300 read and 300 write",
      "60 of each",
      "eligible Google Workspace or Google AI plan",
      "AI Expanded Access"
    ],
    "must_not_match": [
      "updated May 29, 2026",
      "higher-limit period to run through July 15"
    ]
  }
]
